# LLM providers (at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval tools
TAVILY_API_KEY=
NEWSAPI_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Persistence (local dev uses SQLite + Chroma; Vercel needs these)
DATABASE_URL=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Observability (LangSmith). Tracing is a no-op unless TRACING is true AND a key is set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-researcher
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your workspace is in the EU
# LANGSMITH_WORKSPACE_ID=                                 # only for org-scoped API keys

# Run limits (keep small on Vercel Hobby: 300 s function cap)
MAX_HOPS=1
RUN_BUDGET_SECONDS=240
