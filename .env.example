# LLM provider: OpenRouter (one key, any vendor). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Per-tier model overrides (defaults: opus-5.5 / sonnet-5 / haiku-4.5 via anthropic/*)
# OPENROUTER_MODEL_HEAVY=anthropic/claude-opus-5.5        # planner, analysis, insight, critic
# OPENROUTER_MODEL_WORKER=anthropic/claude-sonnet-5       # retriever, report
# OPENROUTER_MODEL_CHEAP=anthropic/claude-haiku-4.5       # validator, grader
# OPENROUTER_MODEL_INSIGHT=openai/gpt-5.1                 # per-role override beats the tier
# Routing (optional)
# OPENROUTER_FALLBACK_MODELS=openai/gpt-5.1,google/gemini-3.1-pro-preview
# OPENROUTER_PROVIDER_ORDER=anthropic,google-vertex
# OPENROUTER_ALLOW_FALLBACKS=true
# OPENROUTER_ZDR=false
# OPENROUTER_SORT=price
# OPENROUTER_REASONING_EFFORT=low   # none|minimal|low|medium|high; reasoning tokens count against max_tokens
OPENROUTER_APP_URL=https://github.com/pj-nx/multi-agent-deep-researcher
OPENROUTER_APP_TITLE=Multi-Agent Deep Researcher

# Embeddings for the evidence store: 256-dimensional vectors from a Matryoshka-trained model.
# Default is a LOCAL model: no key, no server.
#   local      -> Snowflake/snowflake-arctic-embed-m-v1.5 (MRL, trained for 256)  (uv sync --extra embeddings-local)
#   openrouter -> openai/text-embedding-3-small via OpenRouter, OPENROUTER_API_KEY (uv sync --extra embeddings-openai)
#                 this is the setting for AWS / Vercel deployments
#   openai     -> text-embedding-3-small, same vectors as the openrouter default     (uv sync --extra embeddings-openai)
#   ollama     -> nomic-embed-text (MRL v1.5) on a local Ollama server              (uv sync --extra embeddings-ollama)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_DIMENSIONS=256          # or "native" for the model's full size; fixed-size models (bge, e5, gte) are refused at 256
# EMBEDDINGS_MODEL=Snowflake/snowflake-arctic-embed-m-v1.5
# EMBEDDINGS_DEVICE=cpu            # local: cpu | cuda | mps
# EMBEDDINGS_BASE_URL=             # ollama server or OpenAI-compatible base url
# EMBEDDINGS_API_KEY=              # openai/openrouter; falls back to OPENAI_API_KEY / OPENROUTER_API_KEY
OPENAI_API_KEY=

# Chunking (shared by every ingest path). Tokens counted with tiktoken cl100k_base.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_UNIT=tokens                  # tokens | chars

# Persistent vector DB (embedded Chroma). One writer process per path.
CHROMA_PATH=.chroma
CHROMA_COLLECTION=evidence

# Retrieval sources. Keyless and always on: arXiv, Semantic Scholar (low shared rate limit; a key
# raises it and avoids 429s), Wikipedia, GDELT (news fallback, 1 request / 5 s). Keys enable more:
TAVILY_API_KEY=                    # web + reports (tavily.com)
NEWSAPI_KEY=                       # news; preferred over GDELT when set (newsapi.org)
SEMANTIC_SCHOLAR_API_KEY=          # optional, higher rate limit
# RETRIEVAL_FETCH_FULL_TEXT=false  # fetch PDFs/HTML for short results (slower, richer evidence)
# RETRIEVAL_TIMEOUT_SECONDS=30
# WIKIPEDIA_LANG=en

# Graph persistence (plan approval resumes from here)
CHECKPOINTER=sqlite                # sqlite | memory  (postgres arrives with the hosted deployment)
CHECKPOINT_DB=.checkpoints.sqlite

# Hosted persistence for Vercel (local dev uses SQLite + the Chroma path above)
DATABASE_URL=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Observability (LangSmith). Tracing is a no-op unless TRACING is true AND a key is set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-researcher
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your workspace is in the EU
# LANGSMITH_WORKSPACE_ID=                                 # only for org-scoped API keys

# Run limits (keep small on Vercel Hobby: 300 s function cap)
MAX_HOPS=1
RUN_BUDGET_SECONDS=240

# API protection (see api/index.py). Leave API_AUTH_TOKEN empty for open local dev; set it on Vercel.
API_AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=6
MAX_CONCURRENT_RUNS=3
# Trust x-real-ip / x-forwarded-for for rate limiting. Defaults to true on Vercel, false elsewhere.
# TRUST_PROXY_HEADERS=false
